  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-network"
      },
      "description": "看每个探测目标的日常延迟水平。它最适合判断哪一层开始持续变慢：如果路由器和光猫都正常，但外网目标整体抬升，通常更像运营商或更远端链路问题。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "displayName": "${__field.labels.url}",
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"average_response_ms\")\r\n  |> group(columns: [\"url\"])\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "平均延迟：整体是否变慢",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-network"
      },
      "description": "看每个探测目标的丢包率。这个面板最适合定位'断线'和'卡顿'，因为很多游戏瞬断不是平均延迟高，而是短时丢包突然增加。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "displayName": "${__field.labels.url}",
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"percent_packet_loss\")\r\n  |> group(columns: [\"url\"])\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "丢包率：是否出现瞬断",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-network"
      },
      "description": "看每个探测目标的峰值延迟，也就是尖刺。平均值可能不高，但只要最大延迟经常突然冲高，游戏里就会表现成卡顿、回弹或瞬移。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "auto",
            "spanNulls": false
          },
          "displayName": "${__field.labels.url}",
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"maximum_response_ms\")\r\n  |> map(fn: (r) => ({ _time: r._time, _value: float(v: r._value), url: r.url }))\r\n  |> group(columns: [\"url\"])\r\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\r\n  |> yield(name: \"max\")",
          "refId": "A"
        }
      ],
      "title": "最大延迟：是否有尖刺抖动",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-network"
      },
      "description": "按目标显示最近 5 分钟的状态时间线，依据丢包率分级着色：正常(0%)、轻微丢包(0-30%)、中度丢包(30-50%)、重度丢包(50-80%)、严重丢包(>80%)、离线(100%)，灰色表示没有采集到数据。这个面板最适合回看具体是哪个端点先掉线。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "gray",
                  "text": "无数据"
                }
              },
              "type": "special"
            },
            {
              "options": {
                "正常": {
                  "color": "green",
                  "text": "正常"
                },
                "轻微丢包": {
                  "color": "yellow",
                  "text": "轻微丢包"
                },
                "中度丢包": {
                  "color": "orange",
                  "text": "中度丢包"
                },
                "重度丢包": {
                  "color": "dark-orange",
                  "text": "重度丢包"
                },
                "严重丢包": {
                  "color": "red",
                  "text": "严重丢包"
                },
                "离线": {
                  "color": "dark-red",
                  "text": "离线"
                }
              },
              "type": "value"
            }
          ],
          "displayName": "${__field.labels.url}"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 18
      },
      "id": 4,
      "options": {
        "colWidth": 0.9,
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: -5m)\r\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"percent_packet_loss\")\r\n  |> map(fn: (r) => ({ _time: r._time, url: r.url, _value: if r._value >= 100.0 then \"离线\" else if r._value > 80.0 then \"严重丢包\" else if r._value > 50.0 then \"重度丢包\" else if r._value > 30.0 then \"中度丢包\" else if r._value > 0.0 then \"轻微丢包\" else \"正常\" }))\r\n  |> group(columns: [\"url\"])\r\n  |> aggregateWindow(every: 5s, fn: last, createEmpty: false)\r\n  |> yield(name: \"状态\")",
          "refId": "A"
        }
      ],
      "title": "最近 5 分钟状态时间线",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-network"
      },
      "description": "统计当前时间范围内每个目标出现丢包（percent_packet_loss > 0）的采样点次数，并按次数从高到低排序。这里的次数不是网络工程里的严格告警次数，而是 Telegraf 每次探测出现丢包的样本数，适合快速比较谁最不稳定。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "目标 IP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "_value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "异常次数"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "异常次数"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"ping\" and r._field == \"percent_packet_loss\")\r\n  |> map(fn: (r) => ({ r with _value: if r._value > 0.0 then 1 else 0 }))\r\n  |> group(columns: [\"url\"])\r\n  |> sum()\r\n  |> keep(columns: [\"url\", \"_value\"])\r\n  |> sort(columns: [\"_value\"], desc: true)",
          "refId": "A"
        }
      ],
      "title": "最近异常次数排行",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "_value": 1,
              "url": 0
            },
            "renameByName": {
              "_value": "异常次数",
              "url": "目标 IP"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
