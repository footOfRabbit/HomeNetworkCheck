      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-network"
          },
          "query": "from(bucket: \"network\")\r\n  |> range(start: -1d)\r\n  |> filter(fn: (r) => r._measurement == \"traceroute\" and r._field == \"rtt_ms\")\r\n  |> group()\r\n  |> last()\r\n  |> map(fn: (r) => ({ _value: int(v: r._time) / 1000000 }))",
          "refId": "A"
        }
      ],
      "title": "最近探测时间",
      "type": "stat"
    },
